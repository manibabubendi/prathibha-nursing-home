# Copy this file to .env and enter your own values. Never share or publish .env.
PORT=3000
SESSION_SECRET=replace-this-with-a-long-random-secret
ADMIN_USERNAME=payrolladmin
ADMIN_PASSWORD=replace-this-with-a-strong-admin-password

# The address that will receive appointment requests.
APPOINTMENT_RECIPIENT=manibabubendi@gmail.com

# Gmail SMTP example. For Gmail, use an App Password — not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-gmail-app-password

# Use an address you own, normally the same as SMTP_USER.
MAIL_FROM=your-gmail-address@gmail.com
